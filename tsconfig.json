  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "checkJs": false,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
